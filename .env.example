# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and set your Google Cloud Project ID:
#   cp .env.example .env
# ==============================================================================

# Required: Your Google Cloud Project ID (with Billing, BigQuery, Dataplex, and Vertex AI enabled)
GCP_PROJECT_ID="<YOUR_GCP_PROJECT_ID>"
GOOGLE_CLOUD_PROJECT="<YOUR_GCP_PROJECT_ID>"

# BigQuery Dataset (created automatically by `make seed`)
BQ_DATASET_ID="cymbal_retail_my"

# Vertex AI & Gemini Configuration
GOOGLE_GENAI_USE_VERTEXAI="1"
GOOGLE_CLOUD_LOCATION="global"
GEMINI_MODEL="gemini-4-hydrogen"

# Backend FastAPI Server Settings
APP_ENV="development"
PORT=8080
ENABLE_ADK_WEB_UI=true

# Frontend Next.js Proxy Target
BACKEND_API_URL="http://127.0.0.1:8080"
